generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Agency {
  id                   String        @id @default(uuid())
  name                 String
  homeJurisdiction     String        @default("Florida, United States")
  communicationTools   String        @default("[]") // JSON array
  responseTimeDefault  String        @default("24 business hours")
  urgentResponseTime   String        @default("2-4 hours")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  users                User[]
  masterAgreements     MasterAgreement[]
  contractors          Contractor[]
  clients              Client[]
  prospects            Prospect[]
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("contractor") // admin | staff | contractor | client | manager | reviewer | developer | intern

  agencyId     String?
  agency       Agency?   @relation(fields: [agencyId], references: [id])
  contractorId String?
  clientId     String?
  reviews      TaskReview[]
  reviewedBrandKits  BrandKit[]        @relation("BrandKitReviewer")
  auditedInfluencers Influencer[]
  auditsConducted    InfluencerAudit[] @relation("AuditAuditor")
  portfolioItems     PortfolioItem[]
  portalReviews      Review[]          @relation("ReviewReviewer")
  assignedPortalTasks PortalTask[]     @relation("PortalTaskAssignee")
  reviewedPortalTasks PortalTask[]     @relation("PortalTaskReviewer")
  ownedProspects     Prospect[]       @relation("ProspectOwner")
  reviewedGtmAnalyses  GTMAnalysis[]    @relation("GTMReviewedBy")
  createdAt    DateTime @default(now())
}

model Contractor {
  id                  String              @id @default(uuid())
  name                String
  businessName        String
  role                String
  state               String
  country             String              @default("United States")
  status              String              @default("invited") // invited | active | terminated
  taxFormType         String?
  taxFormUrl          String?
  insuranceProofUrl   String?
  licensingProofUrl   String?
  googleDriveFolderId String?
  googleDriveFolderUrl String?
  agencyId            String
  agency              Agency              @relation(fields: [agencyId], references: [id])
  userId              String?
  sows                SOW[]
  assembledContracts  AssembledContract[]
  roles               ContractorRole[]
  trainingAssignments TrainingAssignment[]
  tasks               ProjectTask[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model MasterAgreement {
  id            String   @id @default(uuid())
  agencyId      String
  agency        Agency   @relation(fields: [agencyId], references: [id])
  version       Int      @default(1)
  effectiveDate DateTime @default(now())
  clauses       String   @default("[]") // JSON array of clause objects
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  contracts     AssembledContract[]
}

model Addendum {
  id         String   @id @default(uuid())
  roleType   String
  title      String
  fields     String   @default("[]") // JSON array of field definitions
  content    String   @default("")    // rendered clause content template
  isTemplate Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SOW {
  id                String              @id @default(uuid())
  contractorId      String
  contractor        Contractor          @relation(fields: [contractorId], references: [id])
  rate              Float
  rateType          String              // hourly | half-day | full-day | project | monthly-retainer
  paymentSchedule   String              // weekly | biweekly | monthly | net15 | net30
  startDate         String
  endDate           String?
  specialEquipment  String              @default("")
  software          String              @default("")
  deliverables      String              @default("[]") // JSON array
  attachedAddendumIds String            @default("[]") // JSON array of addendum IDs
  status            String              @default("draft") // draft | active | completed | cancelled
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  contracts         AssembledContract[]
}

model AssembledContract {
  id            String          @id @default(uuid())
  contractorId  String
  contractor    Contractor      @relation(fields: [contractorId], references: [id])
  masterId      String
  master        MasterAgreement @relation(fields: [masterId], references: [id])
  sowId         String?
  sow           SOW?            @relation(fields: [sowId], references: [id])
  addendumIds   String          @default("[]") // JSON array
  mergedContent String          @default("")
  status        String          @default("draft") // draft | pending_signatures | active | terminated
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  signatures    Signature[]
}

model Signature {
  id           String            @id @default(uuid())
  contractId   String
  contract     AssembledContract @relation(fields: [contractId], references: [id])
  signerRole   String            // agency | contractor
  signerName   String
  signerEmail  String
  signatureData String           // base64 signature image
  signatureHash String?           // sha256 of signature payload for tamper-evidence
  signedAt     DateTime          @default(now())
}

model Client {
  id                   String    @id @default(uuid())
  name                 String
  businessName         String?
  email                String    @unique
  phone                String?
  googleDriveFolderId  String?
  googleDriveFolderUrl String?
  agencyId             String
  agency               Agency    @relation(fields: [agencyId], references: [id])
  userId               String?
  status               String    @default("active") // active | inactive
  projects             Project[]
  folders              FileFolder[]
  deliverables         Deliverable[]
  invoices             Invoice[]
  documents            Document[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Project {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  contractorId  String?
  name          String
  description   String   @default("")
  icon          String   @default("📁")
  status        String   @default("planning") // planning | in-progress | review | complete
  progress      Int      @default(0)
  timeline      String   @default("[]") // JSON array of {label, done} objects
  deliverables  Int      @default(0)
  images        String   @default("[]") // JSON array of {url, name, uploadedAt} objects
  sortOrder     Int      @default(0)
  tasks         ProjectTask[]
  portalTasks   PortalTask[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProjectTask {
  id            String    @id @default(uuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractorId  String?
  contractor    Contractor? @relation(fields: [contractorId], references: [id])
  title         String
  description   String    @default("")
  status        String    @default("pending") // pending | in_progress | in_review | completed | blocked
  priority      String    @default("medium") // low | medium | high | urgent
  dueDate       DateTime?
  completedAt   DateTime?
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reviews       TaskReview[]

  @@index([projectId])
  @@index([contractorId])
  @@index([status])
}

model TaskReview {
  id          String    @id @default(uuid())
  taskId      String
  task        ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    User      @relation(fields: [reviewerId], references: [id])
  status      String    @default("pending") // pending | approved | changes_requested | rejected
  feedback    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([taskId])
  @@index([reviewerId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
}

model FileFolder {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  projectId     String?
  name          String
  icon          String   @default("📁")
  driveFolderId String?  // Google Drive folder ID for this specific folder
  driveFolderUrl String? // Fallback shareable URL
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Deliverable {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  projectId     String?
  contractorId  String?
  sowId         String?
  taskId        String?
  name          String
  type          String   @default("document") // image | video | document | design
  status        String   @default("pending") // draft | pending | in-progress | pending-approval | approved | changes-requested
  dueDate       String?
  description   String   @default("")
  sortOrder     Int      @default(0)
  submittedUrl  String?
  submittedAt   DateTime?
  attachments   String   @default("[]") // JSON array of {url, name, type, uploadedAt}
  feedback      String?
  reviewedBy    String?
  reviewedAt    DateTime?
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Invoice {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  invoiceNumber String
  description   String
  project       String?
  amount        Float
  status        String   @default("pending") // paid | pending | upcoming | overdue
  dueDate       String?
  paidDate      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Document {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  name          String
  type          String   @default("document") // contract | nda | proposal | change-order | document
  status        String   @default("available") // signed | pending | available
  fileUrl       String?
  date          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BookingInquiry {
  id           String   @id @default(uuid())
  name         String
  email        String
  organization String?
  eventName    String?
  message      String
  status       String   @default("new") // new | reviewed | replied
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PluginDownloadLead {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String
  city      String
  plugin    String   @default("amazon-associates-snippets")
  version   String   @default("1.1.0")
  createdAt DateTime @default(now())
}

model Prospect {
  id                String   @id @default(uuid())
  agencyId          String
  agency            Agency   @relation(fields: [agencyId], references: [id])
  name              String
  websiteUrl        String?
  instagramHandle   String?
  tiktokHandle      String?
  linkedinUrl       String?
  primaryContactName String?
  primaryContactEmail String?
  primaryContactPhone String?
  industry          String?
  category          String?
  source            String?
  status            String   @default("new") // new | researching | qualified | proposal | accepted | lost
  ownerId           String?
  owner             User?    @relation("ProspectOwner", fields: [ownerId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  intelligence      ProspectIntelligence?
}

model ProspectIntelligence {
  id              String   @id @default(uuid())
  prospectId      String   @unique
  prospect        Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  researchNotes   String   @default("")
  socialProfileData Json?    // structured social media data (followers, engagement, content themes)
  marketFitScore  Float?
  budgetIndicators Json?    // structured budget signals (event history, sponsorships, etc.)
  decisionMakers  Json?    // structured decision maker info
  riskFlags       Json?    // structured risk flags
  competitiveLandscape Json?
  lastResearchedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  gtmAnalysis     GTMAnalysis?
}

model GTMAnalysis {
  id                     String             @id @default(uuid())
  prospectIntelligenceId String             @unique
  prospectIntelligence   ProspectIntelligence @relation(fields: [prospectIntelligenceId], references: [id], onDelete: Cascade)
  strategySummary        String             @default("")
  pricingRecommendations Json?              // structured pricing tiers/packages
  staffingPlan           Json?              // recommended roles, capacity, timeline
  timelineEstimate       Json?              // phases, milestones, durations
  keyRisks               Json?              // identified risks and mitigations
  assumptions            Json?              // key assumptions
  status                 String             @default("draft") // draft | reviewed | approved
  reviewedById           String?
  reviewedBy             User?              @relation("GTMReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String?
  role      String?
  action    String
  method    String?
  path      String?
  entity    String?
  entityId  String?
  ip        String?
  metadata  String? // JSON string
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ContractorRole {
  id            String    @id @default(uuid())
  contractorId  String
  contractor    Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  role          String
  status        String    @default("approved") // pending | approved | rejected
  requestedAt   DateTime  @default(now())
  approvedAt    DateTime?
  approvedBy    String?

  @@unique([contractorId, role])
}

model TrainingLesson {
  id             String   @id @default(uuid())
  slug           String   @unique
  title          String
  description    String?
  version        Int      @default(1)
  targetRole     String   // contractor | client | developer | intern
  steps          Json     // [{ id: string, title: string, order: number }]
  isActive       Boolean  @default(true)
  requiresGithub Boolean  @default(false)
  requiresSlack  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignments    TrainingAssignment[]
}

model TrainingAssignment {
  id           String    @id @default(uuid())
  lessonId     String
  lesson       TrainingLesson @relation(fields: [lessonId], references: [id])
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id])
  status       String    @default("assigned") // assigned | in_progress | completed
  assignedAt   DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  steps            TrainingStepProgress[]
  githubRepository GitHubRepository?
  slackConnection  SlackConnection?

  @@unique([lessonId, contractorId])
}

model TrainingStepProgress {
  id           String             @id @default(uuid())
  assignmentId String
  assignment   TrainingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  stepId       String
  status       String             @default("not_started") // not_started | in_progress | completed
  completedAt  DateTime?
  evidence     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([assignmentId, stepId])
}

model GitHubRepository {
  id                   String             @id @default(uuid())
  assignmentId         String
  assignment           TrainingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  repoName             String
  repoUrl              String
  owner                String
  githubRepositoryId   Int
  defaultBranch        String             @default("main")
  status               String             @default("pending") // pending | creating | created | active | error | archived
  errorMessage         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([assignmentId])
}

model SlackConnection {
  id             String             @id @default(uuid())
  assignmentId   String
  assignment     TrainingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  slackUserId    String?
  slackEmail     String
  slackRealName  String?
  slackDisplayName String?
  workspaceId    String?
  workspaceName  String?
  status         String             @default("pending") // pending | connected | verified | error
  verifiedAt     DateTime?
  verifiedBy     String?            // manual | auto
  errorMessage   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([assignmentId])
}
model PortalTask {
  id              String         @id @default(uuid())
  title           String
  description     String         @default("")
  assignedUserId  String?
  projectId       String?
  status          String         @default("not-started")
  priority        String         @default("medium")
  dueDate         DateTime?
  createdDate     DateTime       @default(now())
  completedDate   DateTime?
  estimatedEffort String         @default("")
  actualEffort    String         @default("")
  deliverable     String         @default("")
  notes           String         @default("")
  reviewStatus    String         @default("pending")
  reviewerId      String?
  portfolioItemId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  assignedUser    User?          @relation("PortalTaskAssignee", fields: [assignedUserId], references: [id])
  portfolioItem   PortfolioItem? @relation(fields: [portfolioItemId], references: [id])
  project         Project?       @relation(fields: [projectId], references: [id])
  reviewer        User?          @relation("PortalTaskReviewer", fields: [reviewerId], references: [id])
}

model PortfolioItem {
  id                 String    @id @default(uuid())
  title              String
  description        String    @default("")
  category           String    @default("web-development")
  assignedUserId     String?
  contributors       String    @default("[]")
  status             String    @default("planned")
  priority           String    @default("medium")
  startDate          DateTime?
  completionDate     DateTime?
  technologies       String    @default("[]")
  skillsDemonstrated String    @default("[]")
  deliverables       String    @default("[]")
  githubRepo         String    @default("")
  liveUrl            String    @default("")
  screenshots        String    @default("[]")
  documentation      String    @default("")
  relatedPortalTaskIds     String    @default("[]")
  relatedAuditIds    String    @default("[]")
  relatedBrandKitIds String    @default("[]")
  completionPercent  Int       @default(0)
  notes              String    @default("")
  isDemo             Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  assignedUser       User?     @relation(fields: [assignedUserId], references: [id])
  tasks              PortalTask[]
}

model Influencer {
  id                  String            @id @default(uuid())
  name                String
  creatorName         String            @default("")
  platform            String            @default("instagram")
  username            String            @default("")
  profileUrl          String            @default("")
  niche               String            @default("")
  audienceDescription String            @default("")
  followerCount       Int               @default(0)
  engagementRate      Float             @default(0)
  contentCategories   String            @default("[]")
  postingFrequency    String            @default("")
  visualIdentity      String            @default("")
  bioQuality          String            @default("")
  profileOptimization String            @default("")
  contentConsistency  String            @default("")
  brandConsistency    String            @default("")
  audienceAlignment   String            @default("")
  growthOpportunities String            @default("")
  strengths           String            @default("[]")
  weaknesses          String            @default("[]")
  recommendations     String            @default("[]")
  overallScore        Float             @default(0)
  auditDate           DateTime?
  auditorId           String?
  status              String            @default("new")
  relatedAuditId      String?
  relatedBrandKitId   String?
  isDemo              Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  brandKits           BrandKit[]
  auditor             User?             @relation(fields: [auditorId], references: [id])
  audits              InfluencerAudit[]
}

model InfluencerAudit {
  id                             String       @id @default(uuid())
  influencerId                   String
  auditorId                      String?
  auditDate                      DateTime     @default(now())
  status                         String       @default("in-progress")
  overallScore                   Float        @default(0)
  profileOptimizationScore       Float        @default(0)
  brandIdentityScore             Float        @default(0)
  contentQualityScore            Float        @default(0)
  contentConsistencyScore        Float        @default(0)
  audienceAlignmentScore         Float        @default(0)
  engagementScore                Float        @default(0)
  discoverabilityScore           Float        @default(0)
  professionalReadinessScore     Float        @default(0)
  brandPartnershipReadinessScore Float        @default(0)
  findings                       String       @default("[]")
  recommendations                String       @default("[]")
  aiGenerated                    Boolean      @default(false)
  aiModel                        String       @default("")
  notes                          String       @default("")
  brandKitId                     String?
  isDemo                         Boolean      @default(false)
  createdAt                      DateTime     @default(now())
  updatedAt                      DateTime     @updatedAt
  scores                         AuditScore[]
  auditor                        User?        @relation("AuditAuditor", fields: [auditorId], references: [id])
  brandKit                       BrandKit?    @relation("AuditBrandKit", fields: [brandKitId], references: [id])
  influencer                     Influencer   @relation(fields: [influencerId], references: [id])
}

model AuditScore {
  id             String          @id @default(uuid())
  auditId        String
  category       String
  score          Float           @default(0)
  evidence       String          @default("")
  recommendation String          @default("")
  weight         Float           @default(1.0)
  createdAt      DateTime        @default(now())
  audit          InfluencerAudit @relation(fields: [auditId], references: [id])
}

model BrandKit {
  id                     String            @id @default(uuid())
  influencerId           String
  name                   String            @default("")
  tagline                String            @default("")
  mission                String            @default("")
  positioning            String            @default("")
  niche                  String            @default("")
  targetAudience         String            @default("")
  brandPersonality       String            @default("")
  primaryColor           String            @default("#000000")
  secondaryColor         String            @default("#FFFFFF")
  accentColor            String            @default("#ED145A")
  backgroundColor        String            @default("#FFFFFF")
  textColor              String            @default("#1E2233")
  headingFont            String            @default("Outfit")
  bodyFont               String            @default("Inter")
  logoUsage              String            @default("")
  photographyDirection   String            @default("")
  graphicStyle           String            @default("")
  iconography            String            @default("")
  instagramBio           String            @default("")
  tiktokBio              String            @default("")
  youtubeDescription     String            @default("")
  linkedinDescription    String            @default("")
  usernameStrategy       String            @default("")
  profileImageGuidance   String            @default("")
  coverBannerGuidance    String            @default("")
  ctaStrategy            String            @default("")
  contentPillars         String            @default("[]")
  voice                  String            @default("")
  tone                   String            @default("")
  vocabulary             String            @default("")
  captionStyle           String            @default("")
  hookStyle              String            @default("")
  ctaStyle               String            @default("")
  storytellingApproach   String            @default("")
  visualContentDirection String            @default("")
  brandConsistencyRules  String            @default("")
  status                 String            @default("draft")
  completionPercent      Int               @default(0)
  reviewerId             String?
  reviewNotes            String            @default("")
  isDemo                 Boolean           @default(false)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  influencer             Influencer        @relation(fields: [influencerId], references: [id])
  reviewer               User?             @relation("BrandKitReviewer", fields: [reviewerId], references: [id])
  sections               BrandKitSection[]
  audits                 InfluencerAudit[] @relation("AuditBrandKit")
  reviews                Review[]
}

model BrandKitSection {
  id          String   @id @default(uuid())
  brandKitId  String
  sectionType String
  title       String
  content     String   @default("{}")
  isCompleted Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  brandKit    BrandKit @relation(fields: [brandKitId], references: [id])
}

model Review {
  id         String   @id @default(uuid())
  brandKitId String
  reviewerId String?
  status     String   @default("pending")
  comments   String   @default("[]")
  score      Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  brandKit   BrandKit @relation(fields: [brandKitId], references: [id])
  reviewer   User?    @relation("ReviewReviewer", fields: [reviewerId], references: [id])
}

