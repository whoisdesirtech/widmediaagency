generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Agency {
  id                  String            @id @default(uuid())
  name                String
  homeJurisdiction    String            @default("Florida, United States")
  communicationTools  String            @default("[]")
  responseTimeDefault String            @default("24 business hours")
  urgentResponseTime  String            @default("2-4 hours")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  clients             Client[]
  contractors         Contractor[]
  masterAgreements    MasterAgreement[]
  users               User[]
}

model User {
  id                 String            @id @default(uuid())
  email              String            @unique
  passwordHash       String
  name               String
  role               String            @default("contractor")
  agencyId           String?
  contractorId       String?
  clientId           String?
  createdAt          DateTime          @default(now())
  reviewedBrandKits  BrandKit[]        @relation("BrandKitReviewer")
  auditedInfluencers Influencer[]
  auditsConducted    InfluencerAudit[] @relation("AuditAuditor")
  portfolioItems     PortfolioItem[]
  reviews            Review[]          @relation("ReviewReviewer")
  assignedTasks      Task[]            @relation("TaskAssignee")
  reviewedTasks      Task[]            @relation("TaskReviewer")
  agency             Agency?           @relation(fields: [agencyId], references: [id])
}

model Contractor {
  id                 String              @id @default(uuid())
  name               String
  businessName       String
  role               String
  state              String
  country            String              @default("United States")
  status             String              @default("invited")
  taxFormType        String?
  taxFormUrl         String?
  insuranceProofUrl  String?
  licensingProofUrl  String?
  agencyId           String
  userId             String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assembledContracts AssembledContract[]
  agency             Agency              @relation(fields: [agencyId], references: [id])
  sows               SOW[]
}

model MasterAgreement {
  id            String              @id @default(uuid())
  agencyId      String
  version       Int                 @default(1)
  effectiveDate DateTime            @default(now())
  clauses       String              @default("[]")
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  contracts     AssembledContract[]
  agency        Agency              @relation(fields: [agencyId], references: [id])
}

model Addendum {
  id         String   @id @default(uuid())
  roleType   String
  title      String
  fields     String   @default("[]")
  content    String   @default("")
  isTemplate Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SOW {
  id                  String              @id @default(uuid())
  contractorId        String
  rate                Float
  rateType            String
  paymentSchedule     String
  startDate           String
  endDate             String?
  specialEquipment    String              @default("")
  software            String              @default("")
  deliverables        String              @default("[]")
  attachedAddendumIds String              @default("[]")
  status              String              @default("draft")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  contracts           AssembledContract[]
  contractor          Contractor          @relation(fields: [contractorId], references: [id])
}

model AssembledContract {
  id            String          @id @default(uuid())
  contractorId  String
  masterId      String
  sowId         String?
  addendumIds   String          @default("[]")
  mergedContent String          @default("")
  status        String          @default("draft")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  contractor    Contractor      @relation(fields: [contractorId], references: [id])
  master        MasterAgreement @relation(fields: [masterId], references: [id])
  sow           SOW?            @relation(fields: [sowId], references: [id])
  signatures    Signature[]
}

model Signature {
  id            String            @id @default(uuid())
  contractId    String
  signerRole    String
  signerName    String
  signerEmail   String
  signatureData String
  signatureHash String?
  signedAt      DateTime          @default(now())
  contract      AssembledContract @relation(fields: [contractId], references: [id])
}

model Client {
  id                   String        @id @default(uuid())
  name                 String
  businessName         String?
  email                String        @unique
  phone                String?
  googleDriveFolderId  String?
  googleDriveFolderUrl String?
  agencyId             String
  userId               String?
  status               String        @default("active")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  agency               Agency        @relation(fields: [agencyId], references: [id])
  deliverables         Deliverable[]
  documents            Document[]
  folders              FileFolder[]
  invoices             Invoice[]
  projects             Project[]
}

model Project {
  id           String   @id @default(uuid())
  clientId     String
  contractorId String?
  name         String
  description  String   @default("")
  icon         String   @default("📁")
  status       String   @default("planning")
  progress     Int      @default(0)
  timeline     String   @default("[]")
  deliverables Int      @default(0)
  images       String   @default("[]")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  client       Client   @relation(fields: [clientId], references: [id])
  tasks        Task[]
}

model FileFolder {
  id             String   @id @default(uuid())
  clientId       String
  name           String
  icon           String   @default("📁")
  driveFolderId  String?
  driveFolderUrl String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  client         Client   @relation(fields: [clientId], references: [id])
}

model Deliverable {
  id           String   @id @default(uuid())
  clientId     String
  projectId    String?
  contractorId String?
  name         String
  type         String   @default("document")
  status       String   @default("pending")
  dueDate      String?
  description  String   @default("")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  client       Client   @relation(fields: [clientId], references: [id])
}

model Invoice {
  id            String   @id @default(uuid())
  clientId      String
  invoiceNumber String
  description   String
  project       String?
  amount        Float
  status        String   @default("pending")
  dueDate       String?
  paidDate      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  client        Client   @relation(fields: [clientId], references: [id])
}

model Document {
  id        String   @id @default(uuid())
  clientId  String
  name      String
  type      String   @default("document")
  status    String   @default("available")
  fileUrl   String?
  date      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id])
}

model BookingInquiry {
  id           String   @id @default(uuid())
  name         String
  email        String
  organization String?
  eventName    String?
  message      String
  status       String   @default("new")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PluginDownloadLead {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String
  city      String
  plugin    String   @default("amazon-associates-snippets")
  version   String   @default("1.1.0")
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String?
  role      String?
  action    String
  method    String?
  path      String?
  entity    String?
  entityId  String?
  ip        String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Task {
  id              String         @id @default(uuid())
  title           String
  description     String         @default("")
  assignedUserId  String?
  projectId       String?
  status          String         @default("not-started")
  priority        String         @default("medium")
  dueDate         DateTime?
  createdDate     DateTime       @default(now())
  completedDate   DateTime?
  estimatedEffort String         @default("")
  actualEffort    String         @default("")
  deliverable     String         @default("")
  notes           String         @default("")
  reviewStatus    String         @default("pending")
  reviewerId      String?
  portfolioItemId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  assignedUser    User?          @relation("TaskAssignee", fields: [assignedUserId], references: [id])
  portfolioItem   PortfolioItem? @relation(fields: [portfolioItemId], references: [id])
  project         Project?       @relation(fields: [projectId], references: [id])
  reviewer        User?          @relation("TaskReviewer", fields: [reviewerId], references: [id])
}

model PortfolioItem {
  id                 String    @id @default(uuid())
  title              String
  description        String    @default("")
  category           String    @default("web-development")
  assignedUserId     String?
  contributors       String    @default("[]")
  status             String    @default("planned")
  priority           String    @default("medium")
  startDate          DateTime?
  completionDate     DateTime?
  technologies       String    @default("[]")
  skillsDemonstrated String    @default("[]")
  deliverables       String    @default("[]")
  githubRepo         String    @default("")
  liveUrl            String    @default("")
  screenshots        String    @default("[]")
  documentation      String    @default("")
  relatedTaskIds     String    @default("[]")
  relatedAuditIds    String    @default("[]")
  relatedBrandKitIds String    @default("[]")
  completionPercent  Int       @default(0)
  notes              String    @default("")
  isDemo             Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  assignedUser       User?     @relation(fields: [assignedUserId], references: [id])
  tasks              Task[]
}

model Influencer {
  id                  String            @id @default(uuid())
  name                String
  creatorName         String            @default("")
  platform            String            @default("instagram")
  username            String            @default("")
  profileUrl          String            @default("")
  niche               String            @default("")
  audienceDescription String            @default("")
  followerCount       Int               @default(0)
  engagementRate      Float             @default(0)
  contentCategories   String            @default("[]")
  postingFrequency    String            @default("")
  visualIdentity      String            @default("")
  bioQuality          String            @default("")
  profileOptimization String            @default("")
  contentConsistency  String            @default("")
  brandConsistency    String            @default("")
  audienceAlignment   String            @default("")
  growthOpportunities String            @default("")
  strengths           String            @default("[]")
  weaknesses          String            @default("[]")
  recommendations     String            @default("[]")
  overallScore        Float             @default(0)
  auditDate           DateTime?
  auditorId           String?
  status              String            @default("new")
  relatedAuditId      String?
  relatedBrandKitId   String?
  isDemo              Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  brandKits           BrandKit[]
  auditor             User?             @relation(fields: [auditorId], references: [id])
  audits              InfluencerAudit[]
}

model InfluencerAudit {
  id                             String       @id @default(uuid())
  influencerId                   String
  auditorId                      String?
  auditDate                      DateTime     @default(now())
  status                         String       @default("in-progress")
  overallScore                   Float        @default(0)
  profileOptimizationScore       Float        @default(0)
  brandIdentityScore             Float        @default(0)
  contentQualityScore            Float        @default(0)
  contentConsistencyScore        Float        @default(0)
  audienceAlignmentScore         Float        @default(0)
  engagementScore                Float        @default(0)
  discoverabilityScore           Float        @default(0)
  professionalReadinessScore     Float        @default(0)
  brandPartnershipReadinessScore Float        @default(0)
  findings                       String       @default("[]")
  recommendations                String       @default("[]")
  aiGenerated                    Boolean      @default(false)
  aiModel                        String       @default("")
  notes                          String       @default("")
  brandKitId                     String?
  isDemo                         Boolean      @default(false)
  createdAt                      DateTime     @default(now())
  updatedAt                      DateTime     @updatedAt
  scores                         AuditScore[]
  auditor                        User?        @relation("AuditAuditor", fields: [auditorId], references: [id])
  brandKit                       BrandKit?    @relation("AuditBrandKit", fields: [brandKitId], references: [id])
  influencer                     Influencer   @relation(fields: [influencerId], references: [id])
}

model AuditScore {
  id             String          @id @default(uuid())
  auditId        String
  category       String
  score          Float           @default(0)
  evidence       String          @default("")
  recommendation String          @default("")
  weight         Float           @default(1.0)
  createdAt      DateTime        @default(now())
  audit          InfluencerAudit @relation(fields: [auditId], references: [id])
}

model BrandKit {
  id                     String            @id @default(uuid())
  influencerId           String
  name                   String            @default("")
  tagline                String            @default("")
  mission                String            @default("")
  positioning            String            @default("")
  niche                  String            @default("")
  targetAudience         String            @default("")
  brandPersonality       String            @default("")
  primaryColor           String            @default("#000000")
  secondaryColor         String            @default("#FFFFFF")
  accentColor            String            @default("#ED145A")
  backgroundColor        String            @default("#FFFFFF")
  textColor              String            @default("#1E2233")
  headingFont            String            @default("Outfit")
  bodyFont               String            @default("Inter")
  logoUsage              String            @default("")
  photographyDirection   String            @default("")
  graphicStyle           String            @default("")
  iconography            String            @default("")
  instagramBio           String            @default("")
  tiktokBio              String            @default("")
  youtubeDescription     String            @default("")
  linkedinDescription    String            @default("")
  usernameStrategy       String            @default("")
  profileImageGuidance   String            @default("")
  coverBannerGuidance    String            @default("")
  ctaStrategy            String            @default("")
  contentPillars         String            @default("[]")
  voice                  String            @default("")
  tone                   String            @default("")
  vocabulary             String            @default("")
  captionStyle           String            @default("")
  hookStyle              String            @default("")
  ctaStyle               String            @default("")
  storytellingApproach   String            @default("")
  visualContentDirection String            @default("")
  brandConsistencyRules  String            @default("")
  status                 String            @default("draft")
  completionPercent      Int               @default(0)
  reviewerId             String?
  reviewNotes            String            @default("")
  isDemo                 Boolean           @default(false)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  influencer             Influencer        @relation(fields: [influencerId], references: [id])
  reviewer               User?             @relation("BrandKitReviewer", fields: [reviewerId], references: [id])
  sections               BrandKitSection[]
  audits                 InfluencerAudit[] @relation("AuditBrandKit")
  reviews                Review[]
}

model BrandKitSection {
  id          String   @id @default(uuid())
  brandKitId  String
  sectionType String
  title       String
  content     String   @default("{}")
  isCompleted Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  brandKit    BrandKit @relation(fields: [brandKitId], references: [id])
}

model Review {
  id         String   @id @default(uuid())
  brandKitId String
  reviewerId String?
  status     String   @default("pending")
  comments   String   @default("[]")
  score      Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  brandKit   BrandKit @relation(fields: [brandKitId], references: [id])
  reviewer   User?    @relation("ReviewReviewer", fields: [reviewerId], references: [id])
}
