generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Agency {
  id                   String        @id @default(uuid())
  name                 String
  homeJurisdiction     String        @default("Florida, United States")
  communicationTools   String        @default("[]") // JSON array
  responseTimeDefault  String        @default("24 business hours")
  urgentResponseTime   String        @default("2-4 hours")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  users                User[]
  masterAgreements     MasterAgreement[]
  contractors          Contractor[]
  clients              Client[]
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("contractor") // admin | staff | contractor | client
  agencyId     String?
  agency       Agency?   @relation(fields: [agencyId], references: [id])
  contractorId String?
  clientId     String?
  createdAt    DateTime @default(now())
}

model Contractor {
  id                  String              @id @default(uuid())
  name                String
  businessName        String
  role                String
  state               String
  country             String              @default("United States")
  status              String              @default("invited") // invited | active | terminated
  taxFormType         String?
  taxFormUrl          String?
  insuranceProofUrl   String?
  licensingProofUrl   String?
  googleDriveFolderId String?
  googleDriveFolderUrl String?
  agencyId            String
  agency              Agency              @relation(fields: [agencyId], references: [id])
  userId              String?
  sows                SOW[]
  assembledContracts  AssembledContract[]
  roles               ContractorRole[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model MasterAgreement {
  id            String   @id @default(uuid())
  agencyId      String
  agency        Agency   @relation(fields: [agencyId], references: [id])
  version       Int      @default(1)
  effectiveDate DateTime @default(now())
  clauses       String   @default("[]") // JSON array of clause objects
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  contracts     AssembledContract[]
}

model Addendum {
  id         String   @id @default(uuid())
  roleType   String
  title      String
  fields     String   @default("[]") // JSON array of field definitions
  content    String   @default("")    // rendered clause content template
  isTemplate Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SOW {
  id                String              @id @default(uuid())
  contractorId      String
  contractor        Contractor          @relation(fields: [contractorId], references: [id])
  rate              Float
  rateType          String              // hourly | half-day | full-day | project | monthly-retainer
  paymentSchedule   String              // weekly | biweekly | monthly | net15 | net30
  startDate         String
  endDate           String?
  specialEquipment  String              @default("")
  software          String              @default("")
  deliverables      String              @default("[]") // JSON array
  attachedAddendumIds String            @default("[]") // JSON array of addendum IDs
  status            String              @default("draft") // draft | active | completed | cancelled
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  contracts         AssembledContract[]
}

model AssembledContract {
  id            String          @id @default(uuid())
  contractorId  String
  contractor    Contractor      @relation(fields: [contractorId], references: [id])
  masterId      String
  master        MasterAgreement @relation(fields: [masterId], references: [id])
  sowId         String?
  sow           SOW?            @relation(fields: [sowId], references: [id])
  addendumIds   String          @default("[]") // JSON array
  mergedContent String          @default("")
  status        String          @default("draft") // draft | pending_signatures | active | terminated
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  signatures    Signature[]
}

model Signature {
  id           String            @id @default(uuid())
  contractId   String
  contract     AssembledContract @relation(fields: [contractId], references: [id])
  signerRole   String            // agency | contractor
  signerName   String
  signerEmail  String
  signatureData String           // base64 signature image
  signedAt     DateTime          @default(now())
}

model Client {
  id                   String    @id @default(uuid())
  name                 String
  businessName         String?
  email                String    @unique
  phone                String?
  googleDriveFolderId  String?
  googleDriveFolderUrl String?
  agencyId             String
  agency               Agency    @relation(fields: [agencyId], references: [id])
  userId               String?
  status               String    @default("active") // active | inactive
  projects             Project[]
  folders              FileFolder[]
  deliverables         Deliverable[]
  invoices             Invoice[]
  documents            Document[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Project {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  contractorId  String?
  name          String
  description   String   @default("")
  icon          String   @default("📁")
  status        String   @default("planning") // planning | in-progress | review | complete
  progress      Int      @default(0)
  timeline      String   @default("[]") // JSON array of {label, done} objects
  deliverables  Int      @default(0)
  images        String   @default("[]") // JSON array of {url, name, uploadedAt} objects
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
}

model FileFolder {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  projectId     String?
  name          String
  icon          String   @default("📁")
  driveFolderId String?  // Google Drive folder ID for this specific folder
  driveFolderUrl String? // Fallback shareable URL
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Deliverable {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  projectId     String?
  contractorId  String?
  sowId         String?
  name          String
  type          String   @default("document") // image | video | document | design
  status        String   @default("pending") // pending | in-progress | pending-approval | approved | changes-requested
  dueDate       String?
  description   String   @default("")
  sortOrder     Int      @default(0)
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Invoice {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  invoiceNumber String
  description   String
  project       String?
  amount        Float
  status        String   @default("pending") // paid | pending | upcoming | overdue
  dueDate       String?
  paidDate      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Document {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  name          String
  type          String   @default("document") // contract | nda | proposal | change-order | document
  status        String   @default("available") // signed | pending | available
  fileUrl       String?
  date          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BookingInquiry {
  id           String   @id @default(uuid())
  name         String
  email        String
  organization String?
  eventName    String?
  message      String
  status       String   @default("new") // new | reviewed | replied
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PluginDownloadLead {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String
  city      String
  plugin    String   @default("amazon-associates-snippets")
  version   String   @default("1.1.0")
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String?
  role      String?
  action    String
  method    String?
  path      String?
  entity    String?
  entityId  String?
  ip        String?
  metadata  String? // JSON string
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ContractorRole {
  id            String    @id @default(uuid())
  contractorId  String
  contractor    Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  role          String
  status        String    @default("approved") // pending | approved | rejected
  requestedAt   DateTime  @default(now())
  approvedAt    DateTime?
  approvedBy    String?

  @@unique([contractorId, role])
}
